# Origin sistem admin Walida (tanpa slash di akhir)
# Lokal contoh: http://127.0.0.1:8080
WALIDA_API=http://127.0.0.1:8080

# Flask session / JWT
SECRET_KEY=ganti-dengan-secret-acak
JWT_SECRET=ganti-dengan-secret-acak

# Opsional — situs publik TIDAK memakai MongoDB untuk booking/polygon.
# Biarkan kosong. Data tetap lewat WALIDA_API (sistem admin).
# MONGO_URI=
# MONGO_DB=walida
